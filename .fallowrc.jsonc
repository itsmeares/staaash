{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/web/vitest.postgres.config.ts",
    "packages/config/src/release.ts",
    "scripts/release/index.mjs",
  ],
  "dynamicallyLoaded": [
    "apps/web/vitest.postgres.global.ts",
    "apps/web/vitest.postgres.setup.ts",
  ],
  "ignorePatterns": ["packages/db/src/generated/prisma/**"],
  "ignoreDependencies": ["@staaash/config"],
  // components/ui is a vendored component kit: its full API is kept even when
  // the app uses only part of it, and its internals follow upstream.
  "ignoreExports": [{ "file": "apps/web/components/ui/**", "exports": ["*"] }],
  "health": { "ignore": ["apps/web/components/ui/**"] },
  "duplicates": { "ignore": ["apps/web/components/ui/**"] },
}
