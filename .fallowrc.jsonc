{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/*/vite.config.ts",
    "packages/*/vite.config.ts",
    "apps/web/server/main.ts",
    "apps/web/vitest.postgres.config.ts",
    "apps/web/playwright.system.config.ts",
    "packages/config/src/release.ts",
    "scripts/release/index.mjs",
    ".agents/skills/verify-staaash/drive-folder.mjs",
  ],
  "dynamicallyLoaded": [
    "apps/web/vitest.postgres.global.ts",
    "apps/web/vitest.postgres.setup.ts",
  ],
  "ignorePatterns": [
    "packages/db/src/generated/prisma/**",
    "apps/web/e2e/**",
    "apps/web/system/**",
    "!.agents/**",
  ],
  "ignoreDependencies": ["@staaash/config"],
  // packages/ui components are a vendored component kit: its full API is kept even when
  // the app uses only part of it, and its internals follow upstream.
  "ignoreExports": [
    { "file": "packages/ui/src/components/**", "exports": ["*"] },
  ],
  "health": { "ignore": ["packages/ui/src/components/**"] },
  "duplicates": { "ignore": ["packages/ui/src/components/**"] },
}
