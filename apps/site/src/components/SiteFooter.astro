---
import { links } from "../links";

const groups = [
  {
    label: "Product",
    items: [
      { label: "Docs", href: links.docs },
      { label: "Live demo", href: links.demo },
      { label: "Is Staaash right for you?", href: "/docs/right-for-you/" },
      { label: "Roadmap", href: "/docs/roadmap/" },
    ],
  },
  {
    label: "Project",
    items: [
      { label: "GitHub", href: links.repo },
      { label: "Releases", href: links.releases },
      { label: "Discussions", href: links.discussions },
      { label: "Report a bug", href: links.issues },
    ],
  },
  {
    label: "Contact",
    items: [{ label: "security@staaash.org", href: links.security }],
  },
];
---

<footer class="mt-24 border-t border-hairline pt-12 pb-6">
  <div class="grid gap-10 sm:grid-cols-[1.4fr_repeat(3,1fr)]">
    <p class="max-w-64 text-meta text-muted-foreground">
      Staaash is free and open source under the{" "}
      <a href={links.license} class="text-foreground underline underline-offset-4">AGPL-3.0</a>.
      No cloud account, no monthly bill.
    </p>
    {
      groups.map((group) => (
        <nav aria-label={group.label}>
          <h2 class="font-sans text-label font-semibold text-foreground">
            {group.label}
          </h2>
          <ul class="mt-3 grid list-none gap-2 p-0">
            {group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-meta text-muted-foreground no-underline hover:text-foreground"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
</footer>
