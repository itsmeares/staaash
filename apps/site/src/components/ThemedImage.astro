---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  eager?: boolean;
}

const { light, dark, alt, widths, sizes, class: className, eager } = Astro.props;
const loading = eager ? "eager" : "lazy";
---

<Image
  src={light}
  {alt}
  {widths}
  {sizes}
  {loading}
  class:list={["dark:hidden", className]}
/>
<Image
  src={dark}
  {alt}
  {widths}
  {sizes}
  {loading}
  class:list={["hidden dark:block", className]}
/>
