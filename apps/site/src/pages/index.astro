---
import { Image } from "astro:assets";
import { buttonVariants } from "@staaash/ui/components/button";
import { DriveGlyph } from "@staaash/ui/drive-glyph";

import { umamiHead } from "../analytics.mjs";
import PixelField from "../components/landing/PixelField.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { links, siteNav } from "../links";
import "../styles/landing.css";

import hero from "../../../../design/Banner/Staaash README-Dark.webp";
import desktop from "../../../../design/Screenshots/desktop-dark.jpg";
import members from "../../../../design/Screenshots/members-dark.jpg";
import photo from "../../../../design/Screenshots/photo-dark.jpg";
import share from "../../../../design/Screenshots/share-dark.jpg";

const title = "Staaash, the drive for your homelab";
const description =
  "A free, open-source file drive you run on your own computer. Open any file in the browser, share it with a link, and keep folders in sync.";
const canonical = new URL(Astro.url.pathname, Astro.site);

const features = [
  {
    id: "open",
    title: "Open anything",
    text: "Photos, HEIC, video, music, PDFs and text, right in the browser.",
    image: photo,
    alt: "A kitchen photo open in Staaash's viewer, with the rest of the folder along the bottom.",
  },
  {
    id: "share",
    title: "Share a link",
    text: "Add a password or an end date. Visitors need no account.",
    image: share,
    alt: "A shared Home renovation folder shown to a visitor as a photo gallery.",
  },
  {
    id: "people",
    title: "Room for everyone",
    text: "Each person gets a private space and a storage limit.",
    image: members,
    alt: "The members page, listing five family members with their role and storage use.",
  },
  {
    id: "sync",
    title: "Sync folders",
    text: "The desktop app for Windows, macOS and Linux.",
    image: desktop,
    alt: "The desktop app syncing 23 files, with progress for each upload.",
  },
];

const extras = [
  { title: "Find it fast", text: "Press / to search every folder." },
  { title: "Get it back", text: "Trash keeps deleted files for 30 days, with one click to restore." },
  { title: "Drop in whole folders", text: "Drag folders onto the page, or copy them and paste with Ctrl+V." },
  { title: "Folders as a zip", text: "Download any folder in one file." },
];

// Windows is drawn here; Apple and Linux are from Simple Icons (CC0).
const desktopApps = [
  {
    system: "Windows",
    files: "x64, ARM64",
    icon: "M2 2h9.5v9.5H2zM12.5 2H22v9.5h-9.5zM2 12.5h9.5V22H2zM12.5 12.5H22V22h-9.5z",
  },
  {
    system: "macOS",
    files: "Apple silicon, Intel",
    icon: "M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701",
  },
  {
    system: "Linux",
    files: "AppImage, DEB, RPM",
    icon: "M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139zm.529 3.405h.013c.213 0 .396.062.584.198.19.135.33.332.438.533.105.259.158.459.166.724 0-.02.006-.04.006-.06v.105a.086.086 0 01-.004-.021l-.004-.024a1.807 1.807 0 01-.15.706.953.953 0 01-.213.335.71.71 0 00-.088-.042c-.104-.045-.198-.064-.284-.133a1.312 1.312 0 00-.22-.066c.05-.06.146-.133.183-.198.053-.128.082-.264.088-.402v-.02a1.21 1.21 0 00-.061-.4c-.045-.134-.101-.2-.183-.333-.084-.066-.167-.132-.267-.132h-.016c-.093 0-.176.03-.262.132a.8.8 0 00-.205.334 1.18 1.18 0 00-.09.4v.019c.002.089.008.179.02.267-.193-.067-.438-.135-.607-.202a1.635 1.635 0 01-.018-.2v-.02a1.772 1.772 0 01.15-.768c.082-.22.232-.406.43-.533a.985.985 0 01.594-.2zm-2.962.059h.036c.142 0 .27.048.399.135.146.129.264.288.344.465.09.199.14.4.153.667v.004c.007.134.006.2-.002.266v.08c-.03.007-.056.018-.083.024-.152.055-.274.135-.393.2.012-.09.013-.18.003-.267v-.015c-.012-.133-.04-.2-.082-.333a.613.613 0 00-.166-.267.248.248 0 00-.183-.064h-.021c-.071.006-.13.04-.186.132a.552.552 0 00-.12.27.944.944 0 00-.023.33v.015c.012.135.037.2.08.334.046.134.098.2.166.268.01.009.02.018.034.024-.07.057-.117.07-.176.136a.304.304 0 01-.131.068 2.62 2.62 0 01-.275-.402 1.772 1.772 0 01-.155-.667 1.759 1.759 0 01.08-.668 1.43 1.43 0 01.283-.535c.128-.133.26-.2.418-.2zm1.37 1.706c.332 0 .733.065 1.216.399.293.2.523.269 1.052.468h.003c.255.136.405.266.478.399v-.131a.571.571 0 01.016.47c-.123.31-.516.643-1.063.842v.002c-.268.135-.501.333-.775.465-.276.135-.588.292-1.012.267a1.139 1.139 0 01-.448-.067 3.566 3.566 0 01-.322-.198c-.195-.135-.363-.332-.612-.465v-.005h-.005c-.4-.246-.616-.512-.686-.71-.07-.268-.005-.47.193-.6.224-.135.38-.271.483-.336.104-.074.143-.102.176-.131h.002v-.003c.169-.202.436-.47.839-.601.139-.036.294-.065.466-.065zm2.8 2.142c.358 1.417 1.196 3.475 1.735 4.473.286.534.855 1.659 1.102 3.024.156-.005.33.018.513.064.646-1.671-.546-3.467-1.089-3.966-.22-.2-.232-.335-.123-.335.59.534 1.365 1.572 1.646 2.757.13.535.16 1.104.021 1.67.067.028.135.06.205.067 1.032.534 1.413.938 1.23 1.537v-.043c-.06-.003-.12 0-.18 0h-.016c.151-.467-.182-.825-1.065-1.224-.915-.4-1.646-.336-1.77.465-.008.043-.013.066-.018.135-.068.023-.139.053-.209.064-.43.268-.662.669-.793 1.187-.13.533-.17 1.156-.205 1.869v.003c-.02.334-.17.838-.319 1.35-1.5 1.072-3.58 1.538-5.348.334a2.645 2.645 0 00-.402-.533 1.45 1.45 0 00-.275-.333c.182 0 .338-.03.465-.067a.615.615 0 00.314-.334c.108-.267 0-.697-.345-1.163-.345-.467-.931-.995-1.788-1.521-.63-.4-.986-.87-1.15-1.396-.165-.534-.143-1.085-.015-1.645.245-1.07.873-2.11 1.274-2.763.107-.065.037.135-.408.974-.396.751-1.14 2.497-.122 3.854a8.123 8.123 0 01.647-2.876c.564-1.278 1.743-3.504 1.836-5.268.048.036.217.135.289.202.218.133.38.333.59.465.21.201.477.335.876.335.039.003.075.006.11.006.412 0 .73-.134.997-.268.29-.134.52-.334.74-.4h.005c.467-.135.835-.402 1.044-.7zm2.185 8.958c.037.6.343 1.245.882 1.377.588.134 1.434-.333 1.791-.765l.211-.01c.315-.007.577.01.847.268l.003.003c.208.199.305.53.391.876.085.4.154.78.409 1.066.486.527.645.906.636 1.14l.003-.007v.018l-.003-.012c-.015.262-.185.396-.498.595-.63.401-1.746.712-2.457 1.57-.618.737-1.37 1.14-2.036 1.191-.664.053-1.237-.2-1.574-.898l-.005-.003c-.21-.4-.12-1.025.056-1.69.176-.668.428-1.344.463-1.897.037-.714.076-1.335.195-1.814.12-.465.308-.797.641-.984l.045-.022zm-10.814.049h.01c.053 0 .105.005.157.014.376.055.706.333 1.023.752l.91 1.664.003.003c.243.533.754 1.064 1.189 1.637.434.598.77 1.131.729 1.57v.006c-.057.744-.48 1.148-1.125 1.294-.645.135-1.52.002-2.395-.464-.968-.536-2.118-.469-2.857-.602-.369-.066-.61-.2-.723-.4-.11-.2-.113-.602.123-1.23v-.004l.002-.003c.117-.334.03-.752-.027-1.118-.055-.401-.083-.71.043-.94.16-.334.396-.4.69-.533.294-.135.64-.202.915-.47h.002v-.002c.256-.268.445-.601.668-.838.19-.201.38-.336.663-.336zm7.159-9.074c-.435.201-.945.535-1.488.535-.542 0-.97-.267-1.28-.466-.154-.134-.28-.268-.373-.335-.164-.134-.144-.333-.074-.333.109.016.129.134.199.2.096.066.215.2.36.333.292.2.68.467 1.167.467.485 0 1.053-.267 1.398-.466.195-.135.445-.334.648-.467.156-.136.149-.267.279-.267.128.016.034.134-.147.332a8.097 8.097 0 01-.69.468zm-1.082-1.583V5.64c-.006-.02.013-.042.029-.05.074-.043.18-.027.26.004.063 0 .16.067.15.135-.006.049-.085.066-.135.066-.055 0-.092-.043-.141-.068-.052-.018-.146-.008-.163-.065zm-.551 0c-.02.058-.113.049-.166.066-.047.025-.086.068-.14.068-.05 0-.13-.02-.136-.068-.01-.066.088-.133.15-.133.08-.031.184-.047.259-.005.019.009.036.03.03.05v.02h.003z",
  },
];

const wrap = "mx-auto w-full max-w-[1180px] px-6";
const heading = "font-heading font-bold tracking-[-0.025em] text-balance text-foreground";
// A short aside under a block: a bold lead, one sentence, and where to read more.
const note = "mt-5 text-[15px] text-pretty text-muted-foreground";
const noteLink =
  "font-medium whitespace-nowrap text-foreground underline decoration-foreground/25 underline-offset-4 transition-colors hover:decoration-primary";
const download =
  "flex flex-1 items-center gap-2.5 rounded-[10px] px-4 py-2.5 leading-tight transition-[background-color,scale] duration-150 active:scale-[0.97] motion-reduce:active:scale-100";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Staaash" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {umamiHead("staaash.org").map(({ attrs }) => <script is:inline {...attrs}></script>)}
  </head>
  <body class="overflow-x-clip text-base/relaxed">
    <header class="sticky top-0 z-10 bg-background/80 backdrop-blur-md backdrop-saturate-150">
      <div class:list={[wrap, "flex h-16 items-center gap-8"]}>
        <a href="/" class="flex items-center gap-2.5 font-heading text-[21px] font-bold text-foreground">
          <DriveGlyph className="w-7" />Staaash
        </a>
        <nav aria-label="Site" class="hidden gap-6 text-[15px] text-muted-foreground md:flex">
          {siteNav.map((item) => <a href={item.href} class="transition-colors hover:text-foreground">{item.label}</a>)}
        </nav>
        <div class="ml-auto flex items-center gap-5 text-[15px]">
          <a href={links.repo} class="hidden items-center gap-1.5 text-muted-foreground transition-colors hover:text-foreground md:flex" data-umami-event="github">
            <svg viewBox="0 0 24 24" class="size-[18px]" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"></path></svg>
            GitHub
          </a>
          <a href={links.demo} class={buttonVariants({ variant: "inverse", size: "lg" })} data-umami-event="try-demo">Try the demo</a>
        </div>
      </div>
    </header>

    <main>
      <section>
        <div class="hero-field relative isolate -mt-16 pt-[222px] pb-16 text-center md:pt-[310px] md:pb-[110px]">
          <PixelField mark />
          <div class={wrap}>
            <h1 class:list={[heading, "text-[clamp(3rem,7.4vw,6rem)] leading-[1.02] font-extrabold tracking-[-0.04em]"]}>
              The drive for your homelab
            </h1>
            <p class="mx-auto mt-6 max-w-[600px] text-lg text-pretty text-muted-foreground md:text-xl">{description}</p>
            <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
              <a href="#get" class={buttonVariants({ size: "xl" })} data-sweep data-umami-event="get-started">Get Staaash</a>
              <a href={links.demo} class={buttonVariants({ variant: "inverse", size: "xl" })} data-umami-event="try-demo">Try the demo</a>
            </div>
          </div>
        </div>
        <div class={wrap}>
          <div class="hero-glow relative isolate -mt-6">
            <Image
              src={hero}
              alt="Staaash on a laptop and a phone, showing the Home renovation folder."
              widths={[720, 1160, 1600, 2320]}
              sizes="(min-width: 1180px) 1080px, 100vw"
              loading="eager"
              class="mx-auto h-auto w-full max-w-[1080px] [mask-image:linear-gradient(#000_78%,transparent)]"
            />
          </div>
        </div>
      </section>

      <section class:list={[wrap, "pt-26 md:pt-36"]} aria-labelledby="features-title">
        <div class="max-w-[640px]">
          <h2 id="features-title" class:list={[heading, "text-[clamp(2.125rem,4vw,3.25rem)] leading-[1.08]"]}>What Staaash does</h2>
          <p class="mt-3.5 text-lg text-muted-foreground">Everything opens in the browser. The people you share with have nothing to install.</p>
        </div>
        <div class="mt-12 grid items-start gap-7 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-14">
          <div class="feature-tabs relative grid grid-cols-2 md:grid-cols-1" role="tablist" aria-label="Features">
            {
              features.map((feature, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${feature.id}`}
                  aria-controls={`pane-${feature.id}`}
                  aria-selected={index === 0 ? "true" : "false"}
                  tabindex={index === 0 ? 0 : -1}
                  class="group cursor-pointer border-l-2 border-border py-3 pr-3 pl-3.5 text-left transition-colors hover:border-foreground/20 md:py-5.5 md:pr-0 md:pl-5"
                >
                  <strong class="block font-heading text-[clamp(1.25rem,2.2vw,1.75rem)] leading-[1.1] font-bold tracking-[-0.02em] text-muted-foreground transition-colors group-hover:text-foreground/80 group-aria-selected:text-foreground">
                    {feature.title}
                  </strong>
                  <span class="mt-1.5 hidden max-w-[24em] text-[15px] text-muted-foreground md:block">{feature.text}</span>
                </button>
              ))
            }
          </div>
          <div class="md:sticky md:top-24">
            {
              features.map((feature, index) => (
                <figure
                  id={`pane-${feature.id}`}
                  role="tabpanel"
                  aria-labelledby={`tab-${feature.id}`}
                  hidden={index !== 0}
                  class="flex min-h-[calc((100vw-3rem)*0.625)] animate-in items-center justify-center duration-300 fade-in-0 slide-in-from-bottom-1.5 motion-reduce:animate-none md:min-h-[min(480px,34vw)]"
                >
                  <Image
                    src={feature.image}
                    alt={feature.alt}
                    widths={[640, 960, 1440]}
                    sizes="(min-width: 768px) 640px, 100vw"
                    class="h-auto max-h-[calc((100vw-3rem)*0.625)] w-auto rounded-xl shadow-[0_0_0_1px_var(--border),0_30px_80px_oklch(0_0_0/0.55)] md:max-h-[min(480px,34vw)]"
                  />
                </figure>
              ))
            }
          </div>
        </div>
        <ul class="mt-16 grid grid-cols-2 md:grid-cols-4">
          {
            extras.map((extra) => (
              <li class="border-t border-border pt-5 pr-5">
                <b class="block font-semibold text-foreground">{extra.title}</b>
                <span class="mt-1 block text-sm/normal text-muted-foreground">{extra.text}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class:list={[wrap, "pt-26 md:pt-36"]} aria-labelledby="plain-title">
        <div class="max-w-[640px]">
          <h2 id="plain-title" class:list={[heading, "text-[clamp(2.125rem,4vw,3.25rem)] leading-[1.08]"]}>Your files stay plain files</h2>
          <p class="mt-3.5 text-lg text-muted-foreground">Your files are kept as normal files on your own disk, not packed into a database.</p>
        </div>
        <ul class="mt-11 grid overflow-hidden rounded-[20px] bg-card ring-1 ring-border ring-inset md:grid-cols-3">
          <li class="border-border p-7 md:px-8 md:pt-9 md:pb-8">
            <svg viewBox="0 0 40 40" class="size-12" aria-hidden="true"><path d="M4 12a3 3 0 0 1 3-3h8l3 3h15a3 3 0 0 1 3 3v15a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3z" fill="var(--primary)"></path></svg>
            <h3 class:list={[heading, "mt-7 text-[22px]"]}>Normal folders</h3>
            <p class="mt-2 text-muted-foreground">Every file keeps its name and its folder on disk. Copy the folder and you have everything.</p>
          </li>
          <li class="border-t border-border p-7 md:border-t-0 md:border-l md:px-8 md:pt-9 md:pb-8">
            <svg viewBox="0 0 40 40" class="size-12" aria-hidden="true"><path d="M15 4v9M25 4v9" stroke="var(--foreground)" stroke-width="3" stroke-linecap="round"></path><path d="M9 13h22v6a11 11 0 0 1-22 0z" fill="#4a90ff"></path><path d="M20 30v7" stroke="var(--foreground)" stroke-width="3" stroke-linecap="round"></path></svg>
            <h3 class:list={[heading, "mt-7 text-[22px]"]}>Safe through a crash</h3>
            <p class="mt-2 text-muted-foreground">A move or upload never ends half done. If Staaash can't tell what happened, it keeps every file and stops.</p>
          </li>
          <li class="border-t border-border p-7 md:border-t-0 md:border-l md:px-8 md:pt-9 md:pb-8">
            <svg viewBox="0 0 40 40" class="size-12" aria-hidden="true"><circle cx="20" cy="20" r="16" fill="var(--foreground)"></circle><path d="m13 20 5 5 9-10" fill="none" stroke="var(--background)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <h3 class:list={[heading, "mt-7 text-[22px]"]}>Checked on arrival</h3>
            <p class="mt-2 text-muted-foreground">Every upload is checked before it becomes a file, so a broken upload never shows up.</p>
          </li>
        </ul>
        <p class={note}>
          <strong class="font-medium text-foreground">Still keep a backup.</strong> A dead disk takes its files with it.{" "}
          <a href={links.backup} class={noteLink}>Read the backup guide</a>
        </p>
      </section>

      <section id="get" class:list={[wrap, "scroll-mt-16 pt-26 md:pt-36"]} aria-labelledby="get-title">
        <h2 id="get-title" class:list={[heading, "text-[clamp(2.125rem,4vw,3.25rem)] leading-[1.08]"]}>Get Staaash</h2>
        <div class="mt-11 grid border-t border-border md:grid-cols-2">
          <div class="pt-8 md:pr-10">
            <h3 class:list={[heading, "text-[26px]"]}>Run the server</h3>
            <p class="mt-2.5 mb-5.5 max-w-[28em] text-muted-foreground">Set it up with Docker on Linux, macOS or Windows. On Windows, the installer works without Docker.</p>
            <div class="flex flex-wrap gap-2.5">
              <a href={links.install} class:list={[download, "flex-col items-start gap-0.5 bg-foreground text-background hover:bg-foreground/88"]} data-umami-event="get-started">
                <b class="text-[15px] font-semibold">Installation guide</b><small class="text-xs text-background/70">Docker Compose</small>
              </a>
              <a href={links.windowsServer} class:list={[download, "flex-col items-start gap-0.5 ring-1 ring-border ring-inset hover:bg-card"]}>
                <b class="text-[15px] font-semibold">Windows installer</b><small class="text-xs text-muted-foreground">No Docker needed</small>
              </a>
            </div>
          </div>
          <div class="mt-8 border-t border-border pt-8 md:mt-0 md:border-t-0 md:border-l md:pl-10">
            <h3 class:list={[heading, "text-[26px]"]}>Install the desktop app</h3>
            <p class="mt-2.5 mb-5.5 max-w-[28em] text-muted-foreground">Keeps a folder on your computer and your drive the same. Needs Staaash 2.0 or newer on the server.</p>
            <div class="flex flex-wrap gap-2.5">
              {
                desktopApps.map((app) => (
                  <a
                    href={links.latestRelease}
                    class:list={[download, "basis-full ring-1 ring-border ring-inset hover:bg-card sm:basis-0"]}
                    data-umami-event="download-desktop"
                    data-umami-event-system={app.system}
                  >
                    <svg viewBox="0 0 24 24" class="size-[18px] shrink-0 fill-current" aria-hidden="true"><path d={app.icon}></path></svg>
                    <span class="flex flex-col gap-0.5">
                      <b class="text-[15px] font-semibold">{app.system}</b>
                      <small class="text-xs whitespace-nowrap text-muted-foreground">{app.files}</small>
                    </span>
                  </a>
                ))
              }
            </div>
            <p class={note}>
              <strong class="font-medium text-foreground">Not signed yet.</strong> Your computer may stop the first launch.{" "}
              <a href={links.desktopApp} class={noteLink}>How to open it</a>
            </p>
          </div>
        </div>
      </section>

      <section class="closing-field relative isolate mt-26 overflow-hidden border-t border-border py-22 text-center md:mt-36 md:py-30" aria-labelledby="closing-title">
        <PixelField />
        <div class={wrap}>
          <h2 id="closing-title" class:list={[heading, "text-[clamp(2.25rem,5vw,4rem)] leading-[1.05] tracking-[-0.03em]"]}>Try it before you install it</h2>
          <p class="mx-auto mt-4 max-w-[34em] text-muted-foreground">The demo runs in your browser with sample files. Nothing you upload leaves your computer.</p>
          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a href={links.demo} class={buttonVariants({ variant: "inverse", size: "xl" })} data-umami-event="try-demo">Open the demo</a>
            <a href={links.docs} class={buttonVariants({ variant: "outline", size: "xl" })}>Read the docs</a>
