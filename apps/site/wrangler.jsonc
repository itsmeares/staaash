{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "staaash-site",
  "compatibility_date": "2026-11-01",
  "main": "./worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the guides answer in Markdown, so only they run the worker.
    "run_worker_first": ["/docs", "/docs/*"],
  },
  "previews": {},
}
