{
  "name": "web",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "predev": "vp run -w build:deps",
    "dev": "next dev",
    "e2e:prepare": "node scripts/e2e-bootstrap.mjs && node --env-file-if-exists=.env.local scripts/e2e-install-extensions.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-built-runtime.mjs",
    "start": "next start",
    "test:postgres": "vp test run --config vitest.postgres.config.ts",
    "e2e": "playwright test",
    "e2e:visual": "playwright test -c playwright.visual.config.ts",
    "check:styles": "node scripts/check-styles.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-three/fiber": "^9.8.1",
    "@staaash/config": "workspace:*",
    "@staaash/db": "workspace:*",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hash-wasm": "^4.12.0",
    "heic-convert": "^2.1.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
