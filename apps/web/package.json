{
  "name": "web",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "vp run -w build:deps",
    "dev": "node scripts/dev.mjs",
    "e2e:prepare": "node scripts/e2e-bootstrap.mjs",
    "build": "vp build && vp pack",
    "start": "NODE_ENV=production node dist/server/main.mjs",
    "test:postgres": "vp test run --config vitest.postgres.config.ts",
    "e2e": "playwright test",
    "e2e:visual": "playwright test -c playwright.visual.config.ts",
    "check:styles": "node scripts/check-styles.mjs",
    "openapi": "UPDATE_OPENAPI=1 vp test run server/http/openapi.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@staaash/config": "workspace:*",
    "@staaash/db": "workspace:*",
    "@staaash/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-virtual": "^3.14.22",
    "hash-wasm": "^4.12.0",
    "heic-convert": "^2.1.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
