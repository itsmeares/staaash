{
  "name": "worker",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter @staaash/config build && pnpm --filter @staaash/db build",
    "predev": "pnpm run build:deps",
    "prelint": "node ../../scripts/build-check-deps.mjs",
    "pretest": "node ../../scripts/build-check-deps.mjs",
    "pretypecheck": "node ../../scripts/build-check-deps.mjs",
    "dev": "node --env-file=../../.env.local --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/check-built-runtime.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@staaash/config": "workspace:*",
    "@staaash/db": "workspace:*",
    "date-fns": "^4.4.0",
    "tsx": "^4.23.15",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/yazl": "^3.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
