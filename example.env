# Staaash settings. After a change, run: docker compose up -d

# Where your files live on this computer.
UPLOAD_LOCATION=./library

# Where the database lives. Always back it up together with your files.
DB_DATA_LOCATION=./postgres

# Database password. Change it before the first start.
# Letters and numbers only. To make one: openssl rand -hex 24
DB_PASSWORD=change-me

# The port Staaash opens on this computer.
STAAASH_PORT=2113

# The web address people use, for share links. Leave it out for home use.
# STAAASH_PUBLIC_URL=https://drive.example.com

# The Staaash version. Release files set the exact version for you.
STAAASH_VERSION=latest

# HTTPS with Caddy. Put compose.https.yml and Caddyfile next to this file,
# point your domain at this computer, set STAAASH_PUBLIC_URL, remove the # from
# the two lines below, and set STAAASH_PORT=127.0.0.1:2113 so only Caddy can
# reach Staaash.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,compose.https.yml

# Advanced. Leave these alone unless a guide tells you to change them.
# DB_USERNAME=postgres
# DB_DATABASE_NAME=staaash
# SECURE_COOKIES=true
# UPLOAD_STAGING_RETENTION_HOURS=2
