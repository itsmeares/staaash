{
  "name": "staaash",
  "version": "2.0.0-rc.5",
  "description": "Self-hosted personal cloud drive monorepo.",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "web:dev": "pnpm --filter web dev",
    "worker:dev": "pnpm --filter worker dev",
    "desktop:dev": "pnpm --filter desktop build && pnpm --filter desktop start",
    "web:build": "pnpm --filter web build",
    "worker:build": "pnpm --filter worker build",
    "web:test": "vp run --filter web test",
    "web:e2e": "node scripts/ci/stack.mjs",
    "worker:test": "vp run --filter worker test",
    "db:build": "pnpm --filter @staaash/db build",
    "db:test": "vp run --filter @staaash/db test",
    "build": "vp run -r build",
    "lint": "vp run build:deps && vp lint && vp run --filter web check:styles",
    "test": "vp run -r test",
    "test:postgres": "pnpm --filter web test:postgres",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "prepare": "vp config",
    "db:generate": "pnpm --filter @staaash/db db:generate",
    "db:push": "pnpm --filter @staaash/db exec prisma db push",
    "app:clear-caches": "node scripts/clear-caches.mjs",
    "app:reset-local-data": "node scripts/reset-local-data.mjs",
    "quality:fallow": "fallow audit --base origin/main --gate new-only --production-dead-code --production-health --production-dupes --no-css --max-crap 60",
    "build:deps": "vp run --filter \"./packages/*\" build",
    "web:ui": "pnpm --filter web ui"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "fallow": "3.37.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  }
}
